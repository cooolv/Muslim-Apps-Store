rules_version = '2';
service cloud.firestore {
  match /databases/{d}/documents {
    match /store_reviews/{id} {
      allow read: if true;
      allow create, update: if request.auth != null
        && id == request.resource.data.p + '_' + request.auth.uid
        && request.resource.data.u == request.auth.uid
        && request.resource.data.s >= 1 && request.resource.data.s <= 5
        && request.resource.data.t.size() < 500;
      allow delete: if request.auth != null
        && (resource.data.u == request.auth.uid || isAdmin());
    }
  }
}
